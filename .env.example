# ────────────────────────────────────────────────
# Resume Redefined — Environment Variables
# Copy this file to .env and fill in the values.
# ────────────────────────────────────────────────

# PostgreSQL connection string (local or cloud)
DATABASE_URL=postgresql://postgres@localhost:5432/resumeredefined

# Secret key for signing JWT tokens (any long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# Backend API server port (5001 — macOS AirPlay uses 5000)
PORT=5001

# Frontend origin for CORS (leave empty to allow all in dev)
# FRONTEND_URL=http://localhost:5173
